# Copy to .env before docker compose or a host-side runserver.
# This file is the template. .env is not committed.
#
# Host-side Django uses POSTGRES_HOST=localhost.
# Development Compose overrides POSTGRES_HOST to the db service and Celery to redis://redis:6379.
# Production Compose (docker-compose.prod.yml) overrides the database host, forces DJANGO_DEBUG=0,
# and points Celery and the throttle cache at password-protected Redis.
# Do not point a laptop venv at host "db".

# Local development keeps DJANGO_DEBUG=1.
# Production Compose forces 0. A debug-off process refuses a missing key, a key shorter than
# 50 characters, a key with too few distinct characters, and any key that starts with dev-only-.
DJANGO_SECRET_KEY=dev-only-synfotalent-secret-key-change-before-any-shared-deployment-0001-local
DJANGO_DEBUG=1

# Include 127.0.0.1 so container health checks work. Add the public hostname before go-live.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Required by production Compose. Use a long URL-safe value (letters and digits only) so it can
# sit inside redis:// URLs. Development Compose does not use this and publishes Redis without a password.
REDIS_PASSWORD=

POSTGRES_DB=synfotalent
POSTGRES_USER=synfotalent
POSTGRES_PASSWORD=synfotalent_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Browser origins allowed to call the API from another origin.
# Leave empty in production when Nginx serves the SPA on the same host (the prod image default).
# The debug default, when this variable is unset, is http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Admin POSTs need the public origin, including the scheme. Example: https://talent.example.com
CSRF_TRUSTED_ORIGINS=

# Baked into the production web image at build time. Same-origin /api/v1 matches Nginx.
# Development Vite reads this as the API origin on the host.
VITE_API_URL=http://localhost:8000/api/v1

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional. Production Compose sets this to Redis DB 2 so login throttles are shared across Gunicorn workers.
# Leave empty for the per-process cache used by runserver and the test suite.
CACHE_URL=

# Optional private object storage. Leave the bucket empty to keep resumes on the media volume.
# Keys in the database stay resumes/YYYY/MM/... Copy existing files to those keys before switching.
# Set both access keys, or neither to use an instance role. Never enable public ACLs.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ADDRESSING_STYLE=
AWS_QUERYSTRING_EXPIRE=300

# Throttle rates. Login covers JWT obtain, JWT refresh, and POST /admin/login/.
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=30/min

# HTTPS response headers when DJANGO_DEBUG is off. Nginx also sends HSTS in tls.conf.example.
# Set DJANGO_HSTS_INCLUDE_SUBDOMAINS=0 if this host must not pin every sibling subdomain.
# Set DJANGO_HSTS_PRELOAD=1 only when you intend to submit the domain to the preload list.
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
WEB_HTTP_PORT=8080
