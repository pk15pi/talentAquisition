# TLS termination inside Nginx. Mount over /etc/nginx/conf.d/default.conf.
#
# Certificates (PEM):
#   /etc/nginx/certs/fullchain.pem
#   /etc/nginx/certs/privkey.pem
#
# Publish host 80 -> 8080 and host 443 -> 8443. Port 8080 redirects to HTTPS
# except for the unauthenticated health check, so the Compose healthcheck can
# stay on http://127.0.0.1:8080/api/v1/health/.
#
# Django does not redirect HTTP to HTTPS itself (SECURE_SSL_REDIRECT is off).
# This file is that redirect. Django still sends HSTS and Secure cookies when
# DJANGO_DEBUG is off, once it sees X-Forwarded-Proto: https.
#
# Set CSRF_TRUSTED_ORIGINS=https://your.hostname and include that hostname in
# DJANGO_ALLOWED_HOSTS. A platform load balancer can terminate TLS instead of
# this file; in that case keep default.conf and make the load balancer send
# X-Forwarded-Proto: https. Do not let clients reach Gunicorn directly.

server {
    listen 8080;
    server_name _;
    server_tokens off;

    location /api/v1/health/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl;
    server_name _;
    server_tokens off;
    client_max_body_size 12m;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SynfoTLS:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location /media/ {
        return 404;
    }

    location /static/ {
        root /var/www;
        access_log off;
        expires 7d;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /admin/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
